    uint8 public decimals = 18;

    uint256 public totalSupply;

    address public owner;

    mapping(address => uint256) public balanceOf;
    mapping(address => uint256) public dnaScore;

    modifier onlyOwner() {
        require(msg.sender == owner, "Not owner");
        _;
    }

    constructor() {
        owner = msg.sender;
    }

    function updateScore(address user, uint256 score) public onlyOwner {
        dnaScore[user] += score;
    }

    function claimReward() public {
        uint256 score = dnaScore[msg.sender];
        require(score > 0, "No score");

        uint256 reward = score * 1e18;

        balanceOf[msg.sender] += reward;
        totalSupply += reward;

        dnaScore[msg.sender] = 0;
    }

    function mintTo(address user, uint256 amount) public onlyOwner {
        balanceOf[user] += amount;
        totalSupply += amount;
    }
}

