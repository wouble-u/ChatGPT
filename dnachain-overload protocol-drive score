// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract DNACHAIN is ERC20, Ownable {

mapping(address => uint256) public dnaScore;
constructor() ERC20("DNAChain", "DNAC") {
    _mint(msg.sender, 1000000000 * 10 ** decimals());
}
function updateScore(address user, uint256 score) public onlyOwner {
    dnaScore[user] += score;
}
function rewardUser(address user) public onlyOwner {
    uint256 reward = dnaScore[user] * 10**18;
    _mint(user, reward);
    dnaScore[user] = 0;
}
}

